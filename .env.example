# Local-only, cookie-isolated demo sessions. Never enable on a public hostname.
BORROW_ALLOW_LOCAL_DEMO=true

# REQUIRED for authentication and encryption. Generate 32 random bytes as 64 hex
# characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the same key across restarts so existing workspace data remains readable.
BORROW_MASTER_KEY=replace_with_your_64_character_random_hex_key

# Optional for the plain Next.js local server. Ignored when a D1 binding exists.
BORROW_DATA_DIR=.borrow-data

# Set to 1 on the hosted Worker to require durable D1 storage and fail closed.
BORROW_REQUIRE_D1=0

# Optional server-side model assistance. Empty means the explicitly labeled,
# deterministic demo processor. Only gateway-approved fields go to the model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Drive OAuth and blockchain anchoring are not implemented in this build.
# They cannot be enabled by adding credentials alone.
